# 내 PC 시험용 규칙. sid 1000000번대는 사용자 규칙 영역이다.
alert http any any -> any any (msg:"LAB 평문 HTTP로 password 전송"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"password="; sid:1000001; rev:1;)
alert http any any -> any any (msg:"LAB 경로 이탈 ../ 요청(정규화된 uri)"; flow:established,to_server; http.uri; content:"../"; sid:1000002; rev:1;)
alert http any any -> any any (msg:"LAB 경로 이탈 ../ 요청(원본 uri)"; flow:established,to_server; http.uri.raw; content:"../"; sid:1000004; rev:1;)
alert tcp any any -> any any (msg:"LAB 짧은 시간에 SYN 다수(포트 스캔 의심)"; flags:S; threshold:type both, track by_src, count 20, seconds 5; sid:1000003; rev:1;)
