{
  "index_patterns": ["access-*"],
  "template": {
    "settings": {
      "number_of_replicas": 0,
      "index.default_pipeline": "access-geoip"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "source": {
          "properties": {
            "ip": { "type": "ip" },
            "geo": { "properties": { "location": { "type": "geo_point" } } },
            "as": {
              "properties": {
                "asn": { "type": "long" },
                "organization_name": { "type": "keyword" }
              }
            }
          }
        },
        "http": {
          "properties": {
            "request": { "properties": { "method": { "type": "keyword" } } },
            "response": { "properties": { "status_code": { "type": "integer" } } }
          }
        },
        "url": { "properties": { "path": { "type": "keyword" } } }
      }
    }
  }
}
